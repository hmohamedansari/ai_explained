---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('modules', ({ data }) =>
  !data.draft && data.track === 'agents-in-production' && data.status === 'published'
)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Production: Reliable Agent Systems"
  description="Learn observability, reliability and security for agentic systems people need to trust in production."
>
  <Header />

  <main id="main-content" tabindex="-1" class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <section class="max-w-3xl mb-10 sm:mb-12">
      <p class="text-xs font-mono uppercase tracking-[0.18em] text-brand-400 mb-3">Level 3 · Production</p>
      <h1 class="text-3xl sm:text-4xl font-semibold text-white mb-4">Make it worthy of trust.</h1>
      <p class="text-lg text-slate-400 leading-relaxed">A model-enabled demo is not yet a service. This path connects agent systems to the engineering work that keeps real services dependable: SLOs, Golden Signals, OpenTelemetry, Kubernetes, Grafana, fleet operations, resilience and security.</p>
    </section>

    <section class="grid sm:grid-cols-3 gap-4 mb-10">
      {[
        ['See the service', 'Measure the user journey, dependencies and quality guardrails clearly.'],
        ['Control failure', 'Use timeouts, idempotency, queues, safe fallback and human escalation.'],
        ['Protect authority', 'Keep identities, tool permissions, data and supply chain boundaries explicit.'],
      ].map(([title, body], index) => (
        <article class="card">
          <span class="inline-flex w-7 h-7 items-center justify-center rounded-full bg-brand-950/30 border border-brand-500/30 text-xs font-mono text-brand-400 mb-4">{index + 1}</span>
          <h2 class="text-lg font-semibold text-white mb-2">{title}</h2>
          <p class="text-sm text-slate-400 leading-relaxed">{body}</p>
        </article>
      ))}
    </section>

    <section class="rounded-2xl border border-brand-500/20 bg-brand-950/20 p-6 sm:p-8">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
        <div>
          <p class="text-xs font-mono uppercase tracking-[0.14em] text-brand-400 mb-2">Available now</p>
          <h2 class="text-2xl font-semibold text-white">{lessons.length} production lessons</h2>
        </div>
        <a href="/learn/agents-in-production" class="btn-primary">Start the journey →</a>
      </div>
      <ol class="space-y-2 text-sm text-slate-400">
        {lessons.map(lesson => (
          <li class="flex gap-3"><span class="font-mono text-brand-400 shrink-0">{lesson.data.moduleId}</span><span>{lesson.data.title}</span></li>
        ))}
      </ol>
    </section>
  </main>

  <Footer />
</BaseLayout>
