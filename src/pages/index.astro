---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getCollection } from 'astro:content';

const journeys = (await getCollection('journeys')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="AI Explained, without the theatre"
  description="A practical field guide from ordinary automation to agentic systems, built for engineers who want to understand what is actually happening."
>
  <Header />

  <main id="main-content" tabindex="-1" class="flex-1">
    <section class="home-hero overflow-hidden bg-surface">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-10 pb-20 sm:pb-28">
        <div class="max-w-3xl">
          <p class="inline-flex items-center gap-2 px-3 py-1.5 border-l-4 border-mulberry-600 bg-brand-950/30 text-brand-400 text-xs font-mono font-medium mb-6 sm:mb-8">
            An engineering field guide for AI systems
          </p>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold text-white leading-tight tracking-tight mb-5 sm:mb-6">
            Learn AI by looking<br />
            <span>under the hood.</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mb-8 sm:mb-10 leading-relaxed">
            Start with the automation engineers already trust. Then add models, context, tools, memory and agents—without letting a confident answer pretend it is a system design.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4">
            <a href="/learn" class="btn-primary text-base px-7 py-3 w-full sm:w-auto justify-center">
              Start the foundations →
            </a>
            <a href="/workbench" class="btn-secondary text-base px-7 py-3 w-full sm:w-auto justify-center">
              Meet the Workbench
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-white/10 bg-surface-1">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
        <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-8 lg:gap-12 items-center">
          <div>
            <p class="text-xs font-mono uppercase tracking-[0.18em] text-brand-400 mb-3">The mental model</p>
            <h2 class="text-2xl sm:text-3xl font-semibold text-white mb-4">A model proposes. The system decides.</h2>
            <p class="text-slate-400 leading-relaxed">
              A useful AI system has a model in it, but it also has context, policy, tools, state, events and a control loop. We will name each part, build it gradually, and see where it can fail.
            </p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm">
            {[
              ['Model', 'generates a proposal'],
              ['Harness', 'interprets the proposal'],
              ['Policy', 'allows, asks or denies'],
              ['Tools', 'perform permitted work'],
              ['State & events', 'record what happened'],
              ['Control loop', 'continues or stops'],
            ].map(([label, detail]) => (
              <div class="rounded-xl border border-white/10 bg-surface p-4">
                <p class="font-medium text-white mb-1">{label}</p>
                <p class="text-xs text-slate-500 leading-relaxed">{detail}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-7">
          <a href="https://hmohamedansari.github.io/there-is-no-agent-talk/" class="text-sm text-brand-400 hover:text-brand-300 transition-colors" target="_blank" rel="noopener noreferrer">
            Start with the talk: There Is No Agent →
          </a>
        </div>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8 sm:mb-10">
        <div class="max-w-2xl">
          <p class="text-xs font-mono uppercase tracking-[0.18em] text-brand-400 mb-3">A connected curriculum</p>
          <h2 class="text-2xl sm:text-3xl font-semibold text-white mb-3">One application, deeper questions.</h2>
          <p class="text-slate-400 leading-relaxed">Every level grows the same Engineering Troubleshooting Workbench. You should never have to pretend a new buzzword is a new foundation.</p>
        </div>
        <a href="/learn" class="text-sm font-medium text-brand-400 hover:text-brand-300 transition-colors shrink-0">See the whole path →</a>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        {journeys.map((journey) => (
          <a href={journey.data.status === 'published' ? `/learn/${journey.data.track}` : '/advanced'} class="card group flex flex-col gap-3 min-h-64">
            <div class="flex items-start justify-between gap-3">
              <span class="text-3xl">{journey.data.icon}</span>
              <span class:list={[
                'text-xs px-2 py-0.5 rounded-full border',
                journey.data.status === 'published' ? 'border-brand-500/30 text-brand-400 bg-brand-950/20' : 'border-white/10 text-slate-500 bg-white/5',
              ]}>{journey.data.status === 'published' ? 'Start here' : journey.data.status === 'next' ? 'Next level' : 'On the map'}</span>
            </div>
            <div>
              <p class="text-xs font-mono text-slate-600 mb-1">{journey.data.eyebrow}</p>
              <h3 class="font-semibold text-white group-hover:text-brand-400 transition-colors mb-2">{journey.data.title}</h3>
              <p class="text-sm text-slate-400 leading-relaxed">{journey.data.description}</p>
            </div>
            <span class="mt-auto pt-3 border-t border-white/5 text-xs text-brand-500 group-hover:text-brand-400 transition-colors">{journey.data.status === 'published' ? 'Begin the journey →' : 'See what is coming →'}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="border-t border-white/10 bg-surface-1">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 grid md:grid-cols-[1.2fr_0.8fr] gap-8 items-start">
        <div>
          <p class="text-xs font-mono uppercase tracking-[0.18em] text-brand-400 mb-3">For people who care about the details</p>
          <h2 class="text-2xl font-semibold text-white mb-3">You do not need to know everything to begin.</h2>
          <p class="text-slate-400 leading-relaxed max-w-2xl">Most of us have nodded along to a term we did not fully understand. This is a place to stop doing that. Ask plain questions, run the small examples, and follow the evidence.</p>
        </div>
        <div class="grid gap-3 text-sm">
          <a href="/workbench" class="rounded-lg border border-white/10 bg-surface p-4 text-slate-400 hover:text-white hover:border-brand-500/40 transition-colors">The local Python Workbench <span class="text-brand-400">→</span></a>
          <a href="/tools" class="rounded-lg border border-white/10 bg-surface p-4 text-slate-400 hover:text-white hover:border-brand-500/40 transition-colors">Tools, specifications and references <span class="text-brand-400">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
