---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getCollection } from 'astro:content';

const lessons = (await getCollection('modules', ({ data }) =>
  !data.draft && data.track === 'advanced' && data.status === 'published'
)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Advanced: Agent Systems, MCP and A2A"
  description="A practical route through context, memory, tools, MCP, A2A, multi-agent systems and their operational boundaries."
>
  <Header />

  <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <section class="max-w-3xl mb-10 sm:mb-12">
      <p class="text-xs font-mono uppercase tracking-[0.18em] text-orange-400 mb-3">Level 2 · Advanced systems</p>
      <h1 class="text-3xl sm:text-4xl font-semibold text-white mb-4">Agent systems, without the fog.</h1>
      <p class="text-lg text-slate-400 leading-relaxed">This is where the fun gets serious: context, memory, tool authority, MCP, A2A and multi-agent delegation. The goal is not to collect protocol names. It is to know who owns each decision when the system is busy, wrong or under pressure.</p>
    </section>

    <section class="grid sm:grid-cols-3 gap-4 mb-10">
      {[
        ['Start with the harness', 'A bounded loop, a clear stop condition and authority you can explain.'],
        ['Understand the boundary', 'MCP and A2A connect systems; they do not replace policy or responsibility.'],
        ['Operate the system', 'Every handoff needs evidence, identity, limits and a failure path.'],
      ].map(([title, body], index) => (
        <article class="card">
          <span class="inline-flex w-7 h-7 items-center justify-center rounded-full bg-orange-950/30 border border-orange-500/30 text-xs font-mono text-orange-400 mb-4">{index + 1}</span>
          <h2 class="text-lg font-semibold text-white mb-2">{title}</h2>
          <p class="text-sm text-slate-400 leading-relaxed">{body}</p>
        </article>
      ))}
    </section>

    <section class="rounded-2xl border border-orange-500/20 bg-orange-950/20 p-6 sm:p-8">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
        <div>
          <p class="text-xs font-mono uppercase tracking-[0.14em] text-orange-400 mb-2">Available now</p>
          <h2 class="text-2xl font-semibold text-white">{lessons.length} connected lessons</h2>
        </div>
        <a href="/learn/advanced" class="btn-primary">Start the journey →</a>
      </div>
      <ol class="space-y-2 text-sm text-slate-400">
        {lessons.map(lesson => (
          <li class="flex gap-3"><span class="font-mono text-orange-400 shrink-0">{lesson.data.moduleId}</span><span>{lesson.data.title}</span></li>
        ))}
      </ol>
    </section>
  </main>

  <Footer />
</BaseLayout>
