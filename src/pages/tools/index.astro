---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

const groups = [
  {
    title: 'Build and inspect',
    copy: 'The small set of tools used by the Workbench and lessons.',
    items: [
      ['Python', 'The language used for the Workbench. Start with standard-library code before frameworks.', 'https://www.python.org/'],
      ['Streamlit', 'A thin local browser view for evidence, state and decisions. It is not a Docker requirement.', 'https://streamlit.io/'],
      ['OpenCode', 'A coding companion for setup, small edits, review and learning from a working repository.', 'https://opencode.ai/'],
      ['Groq', 'The planned default model connection once the course reaches model-assisted behaviour. Free-tier limits change, so check the current account page.', 'https://console.groq.com/docs/rate-limits'],
    ],
  },
  {
    title: 'Specifications and primary references',
    copy: 'Read the source when the implementation detail matters.',
    items: [
      ['Model Context Protocol', 'The specification and reference implementation for model-context interoperability.', 'https://modelcontextprotocol.io/'],
      ['Agent2Agent Protocol', 'The protocol for communication between independent agent systems.', 'https://a2a-protocol.org/latest/'],
      ['OpenTelemetry', 'Specifications for telemetry signals and semantic conventions.', 'https://opentelemetry.io/docs/specs/'],
      ['OpAMP', 'Remote management for fleets of telemetry data-collection agents. These are not LLM agents.', 'https://opentelemetry.io/docs/specs/opamp/'],
    ],
  },
  {
    title: 'Reliability and security',
    copy: 'The foundations we will carry into the production path.',
    items: [
      ['Google SRE book', 'The Four Golden Signals and the reasoning behind useful monitoring.', 'https://sre.google/sre-book/monitoring-distributed-systems/'],
      ['OWASP Agentic Top 10', 'A current threat model for agentic applications.', 'https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/'],
      ['NIST AI RMF', 'A framework for managing AI risks across a system lifecycle.', 'https://www.nist.gov/itl/ai-risk-management-framework'],
      ['Kubernetes security', 'Official guidance on RBAC, policies, secrets and workload controls.', 'https://kubernetes.io/docs/concepts/security/'],
    ],
  },
];
---

<BaseLayout
  title="Resources"
  description="Practical tools, specifications and primary references for learning and building AI systems."
>
  <Header />

  <main id="main-content" tabindex="-1" class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <section class="max-w-3xl mb-12">
      <p class="text-xs font-mono uppercase tracking-[0.18em] text-brand-400 mb-3">Useful things, not a catalogue</p>
      <h1 class="text-3xl sm:text-4xl font-semibold text-white mb-4">Resources worth opening.</h1>
      <p class="text-lg text-slate-400 leading-relaxed">A small set of tools and primary sources. Free tiers, product names and protocol details move quickly; when a decision matters, use the source link and check the date.</p>
    </section>

    <div class="space-y-10 sm:space-y-14">
      {groups.map((group) => (
        <section>
          <div class="mb-5">
            <h2 class="text-xl font-semibold text-white mb-1">{group.title}</h2>
            <p class="text-sm text-slate-400">{group.copy}</p>
          </div>
          <div class="grid gap-3">
            {group.items.map(([name, description, url]) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="card group flex items-start justify-between gap-5 py-4 sm:py-5">
                <div>
                  <h3 class="font-semibold text-white group-hover:text-brand-400 transition-colors mb-1">{name}</h3>
                  <p class="text-sm text-slate-400 leading-relaxed">{description}</p>
                </div>
                <span class="text-brand-400 shrink-0">↗</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>
